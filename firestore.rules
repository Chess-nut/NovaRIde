rules_version = '2';

// NovaRide — Cloud Firestore security rules.
//
// Deny by default. The database holds live GPS positions of the TNVS riders
// in the study, so nothing is readable without a signed-in principal whose
// role this file can establish. Three kinds of principal exist:
//
//   OPERATORS — Firebase Auth accounts of the TNVS Operator console, with a
//   role of superAdmin | dispatcher | viewer. The role is read from the
//   `role` custom claim on the ID token first; if the claim is missing or
//   not one of those three, from admins/{uid}.role. No claims are set yet,
//   so today every operator resolves through admins/{uid}. Once a claim is
//   set (tool/set_admin_claims.mjs) the document read is skipped. The
//   console resolves the role the same way, in the same order; if the two
//   ever disagree the rules win, because the console cannot be trusted to
//   police itself.
//
//   MOBILE ACCOUNTS — riders and guardians of the phone app, added in
//   Phase 3. They carry no claim at all and are not operators: an account
//   is whoever `request.auth.uid` says it is, and it may read and write
//   its own users/{uid}, its own riderProfiles/ or guardianProfiles/
//   document. A rider account a Super Admin has linked to a roster entry
//   (riders/{id}.authUid) also reads that one entry and the alerts filed
//   under it, and nothing else of the roster, the alerts or another
//   rider's anything. The one exception to
//   "signed in or nothing" in this whole file is a `get` on
//   usernames/{usernameLower}, which has to work before sign-in because
//   logging in by username means resolving it to an email first; the
//   trade-off is written out above that rule.
//
//   HELMET SERVICE — the identity the ESP32 firmware will authenticate as:
//   a Firebase Auth user carrying the claim `role: helmetService`. It is
//   never a console role (the console rejects it as unprovisioned), and it
//   is the only client that may write telemetry. It must never have an
//   admins/{uid} document: its claim is not a console role, so role()
//   would fall through to that document and hand the helmet an operator's
//   reads. tool/provision_helmet_service.mjs grants the claim and refuses
//   such an account; docs/FIRMWARE_CONTRACT.md is what the helmet may
//   write. A bridge using the Admin SDK bypasses these rules entirely and
//   needs nothing here.
//
// Alias tolerance: `administrator`/`admin` read as superAdmin, `operator`
// as dispatcher, so a claim or document set by hand with the wrong spelling
// degrades to the intended role instead of locking someone out. The
// aliases are never written; the tooling refuses them.
//
// What is enforced beyond "who": the alert lifecycle is linear
// (open → acknowledged → dispatched → resolved) and each step stamps its
// own server timestamp; an alert the helmet raises must carry the fields
// the board queries on and a server-clock `timestamp`, and no alert is
// created without one; history/ is append-only and its `at` must be the
// server clock; a dispatcher's only write to a rider is its status; a Super
// Admin's only write to an existing device is its pairing. Rider validation
// (helmet-id uniqueness, phone format) stays in the console — uniqueness is
// enforced by a transaction over devices/{helmetId}, which rules cannot
// express — and a Super Admin is the only principal who can write the
// fields it governs.
//
// The seed (--dart-define=SEED_FIRESTORE=true) writes riders/, devices/ and
// alerts/ through the client SDK as a signed-in Super Admin; the `create`
// clauses below admit it. It runs once against an empty database.
service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------ identity

    function signedIn() {
      return request.auth != null;
    }

    // Read-side alias tolerance. Anything unrecognised passes through and
    // fails the role checks below.
    function canonicalRole(raw) {
      return (raw == 'administrator' || raw == 'admin')
          ? 'superAdmin'
          : ((raw == 'operator') ? 'dispatcher' : raw);
    }

    function isConsoleRole(r) {
      return r == 'superAdmin' || r == 'dispatcher' || r == 'viewer';
    }

    function claimRole() {
      return canonicalRole(request.auth.token.get('role', ''));
    }

    function adminDocPath() {
      return /databases/$(database)/documents/admins/$(request.auth.uid);
    }

    // Costs one document read per evaluation, only when no usable claim is
    // present. Firestore caches the read within a single request.
    function docRole() {
      return exists(adminDocPath())
          ? canonicalRole(get(adminDocPath()).data.get('role', ''))
          : '';
    }

    function role() {
      return isConsoleRole(claimRole()) ? claimRole() : docRole();
    }

    function isOperator() {
      return signedIn() && isConsoleRole(role());
    }

    function hasRole(roles) {
      return signedIn() && role() in roles;
    }

    function isHelmetService() {
      return signedIn() && request.auth.token.get('role', '') == 'helmetService';
    }

    // ------------------------------------------------------------- helpers

    function onlyChanges(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    function isServerTime(value) {
      return value == request.time;
    }

    // The linear alert lifecycle. '' means "no legal next step". A pending
    // crash (inside its countdown) is acknowledged like an open one: the
    // countdown may hold an alert back from a dispatcher's attention, never
    // from a dispatcher's hands.
    function nextAlertStatus(current) {
      return (current == 'open' || current == 'pending')
          ? 'acknowledged'
          : ((current == 'acknowledged')
              ? 'dispatched'
              : ((current == 'dispatched') ? 'resolved' : ''));
    }

    function isLifecycleStep(status) {
      return status == 'acknowledged' || status == 'dispatched' || status == 'resolved';
    }

    // What the helmet service must put in an alert it raises. The board is
    // orderBy('timestamp'), and Firestore leaves a document without the
    // ordered field out of the query: an alert with no timestamp would be
    // stored, seen by nobody and worked by nobody. A refusal is better —
    // the firmware sees it on the bench, before a helmet ships.
    //
    // Everything required here is a constant or a server transform the
    // firmware can always supply, so a refusal is always a firmware bug and
    // never "the GPS had no fix". That is why a position is not required —
    // a crash with no fix must still reach the board — but a malformed one
    // is refused. `status`, `type` and `riderId` are required because the
    // committed indexes query on them, and a query on a field skips every
    // document without it. The lifecycle stamps belong to the console.
    // docs/FIRMWARE_CONTRACT.md is this, field by field.
    function isHelmetAlert() {
      let d = request.resource.data;
      return d.get('riderId', '') is string && d.get('riderId', '') != ''
          && d.get('deviceId', '') is string && d.get('deviceId', '') != ''
          && d.get('type', '') in ['crash', 'sos', 'alcoholWarning', 'lowBattery']
          && d.get('severity', '') in ['low', 'moderate', 'high']
          && (d.get('status', '') == 'open'
              || (d.get('status', '') == 'pending' && d.get('type', '') == 'crash'))
          && isServerTime(d.get('timestamp', ''))
          && !d.keys().hasAny(['acknowledgedAt', 'dispatchedAt', 'resolvedAt', 'cancelledAt'])
          && isOptionalNumber(d, 'alcoholLevel') && isOptionalNumber(d, 'alcohol_level')
          && isOptionalNumber(d, 'impactMagnitude') && isOptionalNumber(d, 'impact_magnitude')
          && (!('location' in d) || d.location is latlng)
          && isOptionalLatLng(d);
    }

    // ------------------------------------------- the false-positive countdown
    //
    // A crash the helmet raises arrives `pending`. For COUNTDOWN seconds of
    // server time its own linked rider may call it off as a false positive;
    // after that only the console moves it, as if it had arrived open. The
    // countdown can only suppress: an alert nobody cancels escalates on the
    // clock, with no phone involved, so a phone broken in the crash cannot
    // stop it. docs/FIRMWARE_CONTRACT.md §3.8.
    function countdownOpen(alert) {
      return request.time < alert.timestamp + duration.value(15, 's');
    }

    function isRiderCancel() {
      return resource.data.get('status', '') == 'pending'
          && isLinkedRiderOf(resource.data.riderId)
          && countdownOpen(resource.data)
          && onlyChanges(['status', 'cancelledAt'])
          && request.resource.data.status == 'cancelled'
          && isServerTime(request.resource.data.get('cancelledAt', ''));
    }

    // The helmet sets riders/{id}.status = emergency right after the alert,
    // and that write can land before or after the rider cancels. So the
    // rider may stand themself down, emergency → riding, naming the alert
    // they cancelled (statusClearedBy): in the same batch as the cancel, or
    // up to 90 s after the alert arrived, which covers the helmet's write
    // arriving late. No other change, no other alert, no other rider.
    function isRiderStandDown(riderId) {
      let alertId = request.resource.data.get('statusClearedBy', '');
      let alertPath = /databases/$(database)/documents/alerts/$(alertId);
      return alertId is string && alertId != ''
          && isLinkedRiderOf(riderId)
          && onlyChanges(['status', 'statusClearedBy'])
          && resource.data.get('status', '') == 'emergency'
          && request.resource.data.status == 'riding'
          && existsAfter(alertPath)
          && getAfter(alertPath).data.get('riderId', '') == riderId
          && getAfter(alertPath).data.get('status', '') == 'cancelled'
          && request.time < getAfter(alertPath).data.timestamp + duration.value(90, 's');
    }

    function isOptionalNumber(d, field) {
      return !(field in d) || d[field] is number;
    }

    // Both or neither, and in range — which also catches the commonest
    // bug, latitude and longitude swapped (Manila's 121 is no latitude).
    function isOptionalLatLng(d) {
      return (!('lat' in d) && !('lng' in d))
          || (d.get('lat', null) is number && d.get('lng', null) is number
              && d.lat >= -90 && d.lat <= 90
              && d.lng >= -180 && d.lng <= 180);
    }

    // --------------------------------------------------------- collections

    // Roster. Console-owned, camelCase. Read by every operator; created and
    // edited by Super Admins. Dispatchers touch only `status` — the console
    // resets a rider to idle when their last critical alert is resolved —
    // and the helmet service may set it to emergency when it raises a
    // critical alert (the firmware contract in FIRESTORE_SCHEMA.md §2).
    //
    // `authUid` links a roster entry to the rider's own app account. Only a
    // Super Admin writes it, and only to an account whose users/{uid}.role
    // is `rider` — a guardian linked here would read this rider's alerts.
    // One account per rider is the console's check: rules cannot query for
    // it, as with helmet-id uniqueness. Once linked, the rider may read this
    // document: `get`, and the one query the app makes, where authUid is
    // its own uid. The rule is provable from that filter, so no other
    // rider's entry can come back.
    match /riders/{riderId} {
      allow read: if isOperator()
                  || (signedIn() && resource.data.authUid == request.auth.uid);
      allow create: if hasRole(['superAdmin']) && authUidNamesARider();
      allow update: if (hasRole(['superAdmin']) && authUidNamesARider())
                    || ((hasRole(['dispatcher']) || isHelmetService())
                        && onlyChanges(['status']))
                    || isRiderStandDown(riderId);
      allow delete: if false;   // deactivate instead; alert history references riders
    }

    function authUidNamesARider() {
      let next = request.resource.data.get('authUid', null);
      let prev = resource == null ? null : resource.data.get('authUid', null);
      return next == null
          || next == prev
          || (next is string
              && exists(/databases/$(database)/documents/users/$(next))
              && get(/databases/$(database)/documents/users/$(next))
                   .data.get('role', '') == 'rider');
    }

    // The rider app account linked to riders/{riderId}, and nobody else.
    function isLinkedRiderOf(riderId) {
      return signedIn()
          && get(/databases/$(database)/documents/riders/$(riderId))
               .data.get('authUid', '') == request.auth.uid;
    }

    // Telemetry and pairing. Firmware-owned, snake_case, except for the two
    // pairing fields the console owns: `assigned_rider_id` and `paired_at`,
    // written when a Super Admin registers or edits a rider (the same
    // transaction that writes riders/). Operators read; the helmet service
    // writes readings; a Super Admin may create a device document
    // (registering a helmet before it first reports, and the seed) and may
    // update an existing one only to change the pairing — never a reading.
    match /devices/{deviceId} {
      allow read: if isOperator();
      allow create: if isHelmetService() || hasRole(['superAdmin']);
      allow update: if isHelmetService()
                    || (hasRole(['superAdmin'])
                        && onlyChanges(['assigned_rider_id', 'paired_at']));
      allow delete: if false;
    }

    // Alerts. Created by the helmet service (or a Super Admin — the seed),
    // worked by dispatchers and Super Admins through the linear lifecycle.
    // The helmet's create must satisfy the firmware contract above; the
    // seed writes the simulation's historical alerts, so its timestamps are
    // its own, but it may not leave one out either. Each transition may
    // change only `status` and stamp exactly the matching `<status>At` with
    // the server clock, which is what the console's batched write does and
    // what the Reports tab trusts.
    // A linked rider reads their own alerts: `get`, and queries filtered on
    // riderId == their roster id. That is what the countdown listens to.
    match /alerts/{alertId} {
      allow read: if isOperator() || isLinkedRiderOf(resource.data.riderId);
      allow create: if (isHelmetService() && isHelmetAlert())
                    || (hasRole(['superAdmin'])
                        && request.resource.data.get('timestamp', null) is timestamp);
      allow update: if (hasRole(['superAdmin', 'dispatcher'])
                        && onlyChanges(['status', 'acknowledgedAt', 'dispatchedAt', 'resolvedAt'])
                        && isLifecycleStep(request.resource.data.get('status', ''))
                        && request.resource.data.status
                             == nextAlertStatus(resource.data.get('status', 'open'))
                        && isServerTime(request.resource.data.get(request.resource.data.status + 'At', '')))
                    || isRiderCancel();
      allow delete: if false;

      // Audit trail. Append-only: nothing edits or deletes a history entry,
      // and `at` must be the server clock — response-time metrics are the
      // study's evidence and operator machine clocks are not trusted for
      // them. Reads of this path come through the collection-group rule
      // below; this one covers direct reads of a single alert's trail.
      match /history/{entryId} {
        allow read: if isOperator();
        allow create: if hasRole(['superAdmin', 'dispatcher'])
                      && request.resource.data.get('toStatus', 0) is string
                      && request.resource.data.get('actorName', 0) is string
                      && isServerTime(request.resource.data.get('at', ''));
        allow update, delete: if false;
      }
    }

    // The console reads every alert's trail with one collectionGroup
    // listener, and a collection-group query needs a wildcard-path rule; the
    // nested match above does not cover it. Only alerts/ has a history
    // subcollection, so this admits exactly that data.
    match /{path=**}/history/{entryId} {
      allow read: if isOperator();
    }

    // Provisioning. Each operator may read their own document — that is
    // how the console resolves a role before any claim exists — and Super
    // Admins may read them all. Nothing writes here from a client:
    // provisioning happens in the Firebase console or through the Admin
    // SDK, so a compromised operator session cannot mint operators.
    match /admins/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || hasRole(['superAdmin']));
      allow list: if hasRole(['superAdmin']);
      allow write: if false;
    }


    // ----------------------------------------------- mobile app accounts

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isMobileRole(r) {
      return r == 'rider' || r == 'guardian';
    }

    // No credential material is ever stored in Firestore. Firebase Auth
    // holds the password and nothing else needs to; a document that
    // carried a hash would be a copy of the thing Auth exists to protect.
    // `fcmToken` is deliberately not on this list — a push token is an
    // address, not a secret, and the app writes one.
    function noCredentialFields() {
      return !request.resource.data.keys().hasAny([
        'password', 'passwordHash', 'passwordSalt', 'pwd', 'hash', 'salt',
        'idToken', 'accessToken', 'refreshToken', 'customToken', 'token',
        'secret', 'apiKey', 'privateKey'
      ]);
    }

    // True when an update leaves `field` exactly as it was, including
    // leaving it absent. The immutability checks below are all this.
    function keeps(field) {
      return request.resource.data.get(field, null)
          == resource.data.get(field, null);
    }

    // The address on the document has to be the address on the ID token.
    // Without this, a signed-in account could write somebody else's email
    // into its own record — and into the world-readable usernames/ entry.
    function matchesTokenEmail() {
      return request.resource.data.get('email', '').lower()
          == request.auth.token.get('email', '').lower();
    }

    // A rider may only hold a riderProfiles document and a guardian only a
    // guardianProfiles one. During the sign-up transaction users/{uid}
    // does not exist yet — rules see the pre-transaction state — so the
    // first clause admits the create; afterwards the role decides.
    function profileRoleIs(uid, expected) {
      return !exists(/databases/$(database)/documents/users/$(uid))
          || get(/databases/$(database)/documents/users/$(uid))
               .data.get('role', '') == expected;
    }

    // Accounts. Written only by their owner, only through the mobile app's
    // ensureProfile transaction, and read by nobody else — the console has
    // no code that reads these and no reason to.
    //
    // `role` and `createdAt` can never change once written. The role
    // decides which home screen and, in later phases, which rider data an
    // account can reach; createdAt is evidence for the study. `email` and
    // `username` are immutable too: the email is checked against the ID
    // token, and the username is claimed under usernames/ where nothing
    // can be transferred.
    match /users/{uid} {
      allow get: if isOwner(uid);
      allow list: if false;

      allow create: if isOwner(uid)
                    && noCredentialFields()
                    && matchesTokenEmail()
                    && isMobileRole(request.resource.data.get('role', ''))
                    && request.resource.data.get('username', '') is string
                    && request.resource.data.get('username', '') != ''
                    && request.resource.data.get('fullName', 0) is string
                    && isServerTime(request.resource.data.get('createdAt', ''))
                    && isServerTime(request.resource.data.get('updatedAt', ''));

      // Every write stamps the server clock. A client that wants to change
      // anything has to say when, and it does not get to choose when.
      allow update: if isOwner(uid)
                    && noCredentialFields()
                    && keeps('role')
                    && keeps('createdAt')
                    && keeps('email')
                    && keeps('username')
                    && isServerTime(request.resource.data.get('updatedAt', ''))
                    && (keeps('lastLoginAt')
                        || isServerTime(request.resource.data.get('lastLoginAt', '')));

      allow delete: if false;
    }

    // Role-specific profiles. Same owner-only shape as users/; they exist
    // so a rider's fields and a guardian's never share a document and
    // never have to be told apart at read time.
    match /riderProfiles/{uid} {
      allow get: if isOwner(uid);
      allow list: if false;
      allow create: if isOwner(uid)
                    && noCredentialFields()
                    && profileRoleIs(uid, 'rider')
                    && isServerTime(request.resource.data.get('createdAt', ''))
                    && isServerTime(request.resource.data.get('updatedAt', ''));
      allow update: if isOwner(uid)
                    && noCredentialFields()
                    && keeps('createdAt')
                    && isServerTime(request.resource.data.get('updatedAt', ''));
      allow delete: if false;
    }

    match /guardianProfiles/{uid} {
      allow get: if isOwner(uid);
      allow list: if false;
      allow create: if isOwner(uid)
                    && noCredentialFields()
                    && profileRoleIs(uid, 'guardian')
                    && isServerTime(request.resource.data.get('createdAt', ''))
                    && isServerTime(request.resource.data.get('updatedAt', ''));
      allow update: if isOwner(uid)
                    && noCredentialFields()
                    && keeps('createdAt')
                    && isServerTime(request.resource.data.get('updatedAt', ''));
      allow delete: if false;
    }

    // The username index. Document id is the lowercased username.
    //
    // ** This is the one path in the database an unauthenticated client
    // can read, and it is a deliberate trade-off. ** Logging in with a
    // username means turning that username into an email address before
    // Firebase Auth will look at it, and the person doing it is by
    // definition not signed in yet. So `get` is open to anyone.
    //
    // What that costs: somebody who guesses an exact username learns the
    // email address on it. What it does not cost: `list` is denied, so
    // the collection cannot be enumerated, and `hasOnly` below keeps the
    // document to three fields so nothing else is ever exposed here.
    //
    // The alternative is a Cloud Function doing the lookup server-side,
    // which needs the Blaze plan. Revisit if this project moves to it.
    //
    // Uniqueness is enforced by the rules, not just by the app: a claim
    // is a `create`, and `set` on a name somebody already holds is an
    // `update`, which is denied. Two people racing for one username means
    // the second write fails rather than overwrites.
    match /usernames/{usernameLower} {
      allow get: if true;
      allow list: if false;

      allow create: if signedIn()
                    && request.resource.data.keys()
                         .hasOnly(['uid', 'email', 'createdAt'])
                    && request.resource.data.get('uid', '') == request.auth.uid
                    && matchesTokenEmail()
                    && usernameLower == usernameLower.lower()
                    && usernameLower.size() >= 3
                    && usernameLower.size() <= 20
                    && isServerTime(request.resource.data.get('createdAt', ''));

      // A username is never transferred and never freed. Releasing one
      // would let the next person inherit whatever the last one is
      // remembered by.
      allow update, delete: if false;
    }

    // Everything else — including the reserved emergencyContacts/ — stays
    // closed until a rule is written for it here first. rules_test/
    // closed.test.js is what holds that line: it asserts each unopened
    // path is denied, so opening one means editing that file on purpose.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
