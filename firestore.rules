rules_version = '2';

// NovaRide — Cloud Firestore security rules.
//
// LOCKED BY DEFAULT. The database will hold live GPS positions of the TNVS
// riders in the study; open rules would expose their real-time location to
// anyone holding the project id. Firebase Auth is not wired yet (the admin
// login compares hardcoded strings, which is not authentication), so there
// is currently no principal these rules can trust — hence deny-all.
//
// What changes when Auth lands is written up in docs/FIRESTORE_SCHEMA.md
// ("Security rules"). For a supervised demo, deploy firestore.rules.demo
// instead — it is time-boxed and scoped to the three console collections.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
